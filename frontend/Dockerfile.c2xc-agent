FROM node:20-slim AS build

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com/

COPY package.json package-lock.json /app/
RUN npm ci

COPY . /app

# Sub-path deployment: https://<domain>/c2xc-agent/
# Vite reads env vars at build time.
ENV VITE_API_BASE_URL=/c2xc-agent/api/v1

# Vite base is a build-time setting (affects asset URLs and import.meta.env.BASE_URL).
RUN npm run build -- --base=/c2xc-agent/


FROM nginx:1.27-alpine AS runtime

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

COPY frontend.nginx.c2xc-agent.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
